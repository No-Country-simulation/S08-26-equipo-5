# Database - Neon PostgreSQL
DATABASE_URL="postgresql://user:password@ep-xxxxx.region.aws.neon.tech/meetflow?schema=public"

# Server
NODE_ENV=development
PORT=4000
CORS_ORIGIN="http://localhost:3000"

# Auth - JWT
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_TTL_DAYS=7

# Auth - Bcrypt
BCRYPT_SALT_ROUNDS=12

# Frontend (usado para armar enlaces de invitación a la sala)
FRONTEND_URL="http://localhost:3000"

# GetStream Video/Audio (requeridas: el server no arranca sin ellas)
GETSTREAM_API_KEY="your-api-key"
GETSTREAM_API_SECRET="your-api-secret"

# Vigencia del token de GetStream que se entrega al cliente
STREAM_TOKEN_TTL_SECONDS=3600
# Vigencia del "guest JWT" del participante invitado. También define por
# cuánto tiempo un aprobado puede reingresar sin volver a pedir permiso.
PARTICIPANT_TOKEN_TTL_SECONDS=7200

# Webhooks - GetStream (S3-08)
# true|1 exige firma HMAC (default fuera de development). false|0 solo para desarrollo local.
# Nota: el código lee WEBHOOK_SIGNATURE_REQUIRED (ver src/config/env.ts). No confundir
# con el nombre WEBHOOK_VERIFY_SIGNATURE que llegó a estar en una versión anterior de
# este archivo en develop — esa variable no la lee nadie, es un nombre obsoleto.
WEBHOOK_SIGNATURE_REQUIRED=true
# console (default, loguea sin enviar) | resend | brevo
MAIL_PROVIDER=console
# Resend sandbox: onboarding@resend.dev solo entrega al dueño de la cuenta. Con Brevo, sender verificado.
MAIL_FROM=onboarding@resend.dev
# Solo si MAIL_PROVIDER=brevo
BREVO_API_KEY=
# Vigencia de la invitación en horas
INVITACION_TTL_HORAS=72
# Rate limit cada 15 min: invitar (por host) / preview+aceptar (por IP)
RATE_LIMIT_INVITE_MAX=30
RATE_LIMIT_TOKEN_MAX=30
# Foto de perfil (Cloudinary). Opcional: sin CLOUDINARY_URL, PUT /usuarios/me/foto responde 503
CLOUDINARY_URL=
CLOUDINARY_FOLDER=
AVATAR_MAX_BYTES=2097152
RATE_LIMIT_AVATAR_MAX=10
