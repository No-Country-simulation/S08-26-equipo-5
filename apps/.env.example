# Docker Compose (local) — apps/docker-compose.yml

# URL pública del backend que consume el frontend
NEXT_PUBLIC_API_URL=http://localhost:4000

# ─── apps/server/.env ────────────────────────────────────
# Copia apps/server/.env.example a apps/server/.env y completa:
#
# DATABASE_URL="postgresql://user:password@ep-xxxxx.region.aws.neon.tech/meetflow?schema=public"
# NODE_ENV=development
# PORT=4000
# CORS_ORIGIN="http://localhost:3000"
# JWT_SECRET="change-me-to-a-long-random-secret"
# JWT_EXPIRES_IN="15m"
# REFRESH_TOKEN_TTL_DAYS=7
# BCRYPT_SALT_ROUNDS=12
