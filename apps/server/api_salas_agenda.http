@host = http://localhost:4000/api/v1
@email = qa-salas-{{$timestamp}}@test.com
@guestEmail = qa-guest-{{$timestamp}}@test.com
@password = password123
@missingId = 00000000-0000-4000-8000-000000000099

# Contrato v1.0.1. Host crea la sala; el invitado cubre 403 en PUT y DELETE.
# GET /salas/:code es público: no aplica 401 ni 403; se afirma 200 y 404.

### 1. Register host -> 201
POST {{host}}/auth/register
Content-Type: application/json

{
  "nombre": "Ana",
  "apellido": "Gómez",
  "email": "{{email}}",
  "password": "{{password}}"
}

> {%
client.test("register host 201", function() {
  client.assert(response.status === 201, "status " + response.status);
});
%}

### 2. Login host -> 200
# @name login
POST {{host}}/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

> {%
client.test("login host 200", function() {
  client.assert(response.status === 200, "status " + response.status);
  client.global.set("accessToken", response.body.accessToken);
});
%}

### 3. Register invitado -> 201
POST {{host}}/auth/register
Content-Type: application/json

{
  "nombre": "Luis",
  "apellido": "Díaz",
  "email": "{{guestEmail}}",
  "password": "{{password}}"
}

> {%
client.test("register guest 201", function() {
  client.assert(response.status === 201, "status " + response.status);
});
%}

### 4. Login invitado -> 200
# @name guest
POST {{host}}/auth/login
Content-Type: application/json

{
  "email": "{{guestEmail}}",
  "password": "{{password}}"
}

> {%
client.test("login guest 200", function() {
  client.assert(response.status === 200, "status " + response.status);
  client.global.set("guestToken", response.body.accessToken);
});
%}

### 5. POST /salas -> 201
# @name crearSala
POST {{host}}/salas
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "nombre": "Daily Backend",
  "resumen": "Revisión del sprint",
  "fechaInicio": "2026-10-15T18:00:00.000Z"
}

> {%
client.test("crear sala 201", function() {
  client.assert(response.status === 201, "status " + response.status);
  client.assert(!!response.body.salaId, "falta salaId");
  client.assert(!!response.body.codigo, "falta codigo");
  client.global.set("salaId", response.body.salaId);
  client.global.set("salaCodigo", response.body.codigo);
  client.global.set("salaCodigoLower", String(response.body.codigo).toLowerCase());
});
%}

### 6. POST /salas sin nombre -> 400
POST {{host}}/salas
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "resumen": "Sin nombre"
}

> {%
client.test("crear sala 400", function() {
  client.assert(response.status === 400, "status " + response.status);
});
%}

### 7. POST /salas sin token -> 401
POST {{host}}/salas
Content-Type: application/json

{
  "nombre": "Sala sin auth"
}

> {%
client.test("crear sala 401", function() {
  client.assert(response.status === 401, "status " + response.status);
  client.assert(response.body.error.code === "UNAUTHORIZED", JSON.stringify(response.body));
});
%}

### 8. GET /salas/:code -> 200
GET {{host}}/salas/{{salaCodigo}}

> {%
client.test("sala pública 200", function() {
  client.assert(response.status === 200, "status " + response.status);
  client.assert(!!response.body.codigo, "falta codigo");
});
%}

### 8b. GET /salas/:code en minúsculas -> 200
GET {{host}}/salas/{{salaCodigoLower}}

> {%
client.test("código normalizado", function() {
  client.assert(response.status === 200, "status " + response.status);
});
%}

### 8c. POST /salas nombre de 151 -> 400
POST {{host}}/salas
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "nombre": "XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
}

> {%
client.test("nombre 151 es 400", function() {
  client.assert(response.status === 400, "status " + response.status);
});
%}

### 9. GET /salas/:code inexistente -> 404
GET {{host}}/salas/ZZZZ0000

> {%
client.test("sala pública 404", function() {
  client.assert(response.status === 404, "status " + response.status);
});
%}

### 10. GET /salas/mis-participaciones -> 200
GET {{host}}/salas/mis-participaciones
Authorization: Bearer {{accessToken}}

> {%
client.test("agenda 200", function() {
  client.assert(response.status === 200, "status " + response.status);
  client.assert(Array.isArray(response.body.salas), "falta salas");
});
%}

### 11. GET /salas/mis-participaciones sin token -> 401
GET {{host}}/salas/mis-participaciones

> {%
client.test("agenda 401", function() {
  client.assert(response.status === 401, "status " + response.status);
});
%}

