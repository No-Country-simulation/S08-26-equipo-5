{
  "info": {
    "name": "MeetFlow — Auth (S1-01)",
    "description": "Colección de endpoints de autenticación JWT (register, login, refresh, logout, me). Ejecutar en orden: register → login → me → refresh → logout.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api/v1"
    },
    {
      "key": "accessToken",
      "value": "",
      "description": "Se asigna automáticamente tras login"
    },
    {
      "key": "refreshToken",
      "value": "",
      "description": "Se asigna automáticamente tras login"
    },
    {
      "key": "email",
      "value": "juan.test@test.com"
    },
    {
      "key": "password",
      "value": "password123"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        },
        "description": "Verifica que el servidor está operativo."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status es 200', () => { pm.response.to.have.status(200); });",
              "pm.test('Body contiene status ok', () => { const body = pm.response.json(); pm.expect(body.status).to.eql('ok'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "register"]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Juan\",\n  \"apellido\": \"Pérez\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "description": "Registra un nuevo usuario. Retorna 201 con userId. Si el email ya existe, retorna 409."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status es 201 o 409 (email duplicado)', () => {",
              "  pm.expect([201, 409]).to.include(pm.response.code);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Register — Email duplicado",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "register"]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Juan\",\n  \"apellido\": \"Pérez\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "description": "Debería retornar 409 si el email ya está registrado."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status es 409', () => { pm.response.to.have.status(409); });",
              "pm.test('Error code es EMAIL_ALREADY_REGISTERED', () => { const body = pm.response.json(); pm.expect(body.error.code).to.eql('EMAIL_ALREADY_REGISTERED'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Register — Datos inválidos",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "register"]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"\",\n  \"apellido\": \"\",\n  \"email\": \"no-es-email\",\n  \"password\": \"123\"\n}"
        },
        "description": "Debería retornar 400 con errores de validación."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status es 400', () => { pm.response.to.have.status(400); });",
              "pm.test('Body contiene errors array', () => { const body = pm.response.json(); pm.expect(body.error.details).to.be.an('array'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "description": "Login con credenciales válidas. Retorna accessToken y refreshToken."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status es 200', () => { pm.response.to.have.status(200); });",
              "pm.test('Body contiene tokens', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.have.property('accessToken');",
              "  pm.expect(body).to.have.property('refreshToken');",
              "  pm.environment.set('accessToken', body.accessToken);",
              "  pm.environment.set('refreshToken', body.refreshToken);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Login — Credenciales inválidas",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"password-incorrecta\"\n}"
        },
        "description": "Debería retornar 401 con credenciales inválidas."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status es 401', () => { pm.response.to.have.status(401); });",
              "pm.test('Error code es INVALID_CREDENTIALS', () => { const body = pm.response.json(); pm.expect(body.error.code).to.eql('INVALID_CREDENTIALS'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Me — Autenticado",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/auth/me",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "me"]
        },
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "description": "Retorna el perfil del usuario autenticado."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status es 200', () => { pm.response.to.have.status(200); });",
              "pm.test('Body contiene id, nombre, email', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.have.property('id');",
              "  pm.expect(body).to.have.property('nombre');",
              "  pm.expect(body).to.have.property('email');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Me — Sin token",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/auth/me",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "me"]
        },
        "description": "Debería retornar 401 sin token."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status es 401', () => { pm.response.to.have.status(401); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Me — Token inválido",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/auth/me",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "me"]
        },
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer token-de-mentira"
          }
        ],
        "description": "Debería retornar 401 con token inválido."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status es 401', () => { pm.response.to.have.status(401); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Refresh Token",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/auth/refresh",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "refresh"]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
        },
        "description": "Rota el par de tokens. El refresh token viejo queda inválido."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status es 200', () => { pm.response.to.have.status(200); });",
              "pm.test('Body contiene nuevos tokens', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.have.property('accessToken');",
              "  pm.expect(body).to.have.property('refreshToken');",
              "  pm.environment.set('accessToken', body.accessToken);",
              "  pm.environment.set('refreshToken', body.refreshToken);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Refresh — Token viejo (reuso)",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/auth/refresh",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "refresh"]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
        },
        "description": "Debería retornar 401. Reuso de token revoca toda la family."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status es 401', () => { pm.response.to.have.status(401); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Refresh — Sin body",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/auth/refresh",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "refresh"]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "description": "Debería retornar 400 con error de validación."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status es 400', () => { pm.response.to.have.status(400); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Logout",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/auth/logout",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "logout"]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
        },
        "description": "Revoca el refresh token. Idempotente."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status es 200', () => { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Logout — Repetido (idempotente)",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/auth/logout",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "logout"]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
        },
        "description": "Debería retornar 200 aunque ya esté revocado."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status es 200 (idempotente)', () => { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Refresh — Tras logout",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/auth/refresh",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "refresh"]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
        },
        "description": "Debería retornar 401 porque el token fue revocado en logout."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status es 401', () => { pm.response.to.have.status(401); });"
            ]
          }
        }
      ]
    },
    {
      "name": "404 — Ruta no existente",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/no-existe",
          "host": ["{{baseUrl}}"],
          "path": ["no-existe"]
        },
        "description": "Debería retornar 404 para rutas no registradas."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status es 404', () => { pm.response.to.have.status(404); });"
            ]
          }
        }
      ]
    }
  ]
}
