@host = http://localhost:4000/api/v1
@email = qa-inv-host-{{$timestamp}}@test.com
@otherEmail = qa-inv-other-{{$timestamp}}@test.com
@newEmail = qa-inv-nuevo-{{$timestamp}}@test.com
@password = password123
@missingId = 00000000-0000-4000-8000-000000000099

# Invitaciones por correo: invitar (host) y vista previa de token.
# Aceptar la invitacion NO se cubre aca: hace falta el token en claro, que solo
# viaja por correo (ConsoleMailer lo loguea en el server) y la API nunca lo
# devuelve. Ese flujo se prueba en Vitest + supertest.
# Requiere MAIL_PROVIDER sin definir (ConsoleMailer: no sale nada a la red).

### 1. Register host -> 201
POST {{host}}/auth/register
Content-Type: application/json

{
  "nombre": "Host",
  "apellido": "Invita",
  "email": "{{email}}",
  "password": "{{password}}"
}

> {%
client.test("register host 201", function() {
  client.assert(response.status === 201, "status " + response.status);
});
%}

### 2. Login host -> 200
POST {{host}}/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

> {%
client.test("login host 200", function() {
  client.assert(response.status === 200, "status " + response.status);
  client.global.set("accessToken", response.body.accessToken);
});
%}

### 3. Register otro usuario (no host) -> 201
POST {{host}}/auth/register
Content-Type: application/json

{
  "nombre": "Otro",
  "apellido": "Usuario",
  "email": "{{otherEmail}}",
  "password": "{{password}}"
}

> {%
client.test("register otro 201", function() {
  client.assert(response.status === 201, "status " + response.status);
});
%}

### 4. Login otro usuario -> 200
POST {{host}}/auth/login
Content-Type: application/json

{
  "email": "{{otherEmail}}",
  "password": "{{password}}"
}

> {%
client.test("login otro 200", function() {
  client.assert(response.status === 200, "status " + response.status);
  client.global.set("otherToken", response.body.accessToken);
});
%}

### 5. Crear sala -> 201
POST {{host}}/salas
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "nombre": "Invitaciones QA"
}

> {%
client.test("crear sala 201", function() {
  client.assert(response.status === 201, "status " + response.status);
  client.assert(!!response.body.salaId, "falta salaId");
  client.global.set("salaId", response.body.salaId);
});
%}

### 6. Invitar sin JWT -> 401
POST {{host}}/salas/{{salaId}}/invitaciones
Content-Type: application/json

{
  "emails": ["{{newEmail}}"]
}

> {%
client.test("invitar sin JWT 401", function() {
  client.assert(response.status === 401, "status " + response.status);
});
%}

### 7. Invitar como no-host -> 403
POST {{host}}/salas/{{salaId}}/invitaciones
Content-Type: application/json
Authorization: Bearer {{otherToken}}

{
  "emails": ["{{newEmail}}"]
}

> {%
client.test("invitar no-host 403", function() {
  client.assert(response.status === 403, "status " + response.status);
  client.assert(response.body.error.code === "HOST_ONLY", "code " + response.body.error.code);
});
%}

### 8. Invitar a sala inexistente -> 404
POST {{host}}/salas/{{missingId}}/invitaciones
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "emails": ["{{newEmail}}"]
}

> {%
client.test("invitar sala inexistente 404", function() {
  client.assert(response.status === 404, "status " + response.status);
});
%}

### 9. Invitar con emails vacio -> 400
POST {{host}}/salas/{{salaId}}/invitaciones
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "emails": []
}

> {%
client.test("emails vacio 400", function() {
  client.assert(response.status === 400, "status " + response.status);
  client.assert(response.body.error.code === "VALIDATION_ERROR", "code " + response.body.error.code);
});
%}

### 10. Invitar con email invalido -> 400
POST {{host}}/salas/{{salaId}}/invitaciones
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "emails": ["esto-no-es-un-mail"]
}

> {%
client.test("email invalido 400", function() {
  client.assert(response.status === 400, "status " + response.status);
  client.assert(response.body.error.code === "VALIDATION_ERROR", "code " + response.body.error.code);
});
%}

### 11. Invitar (un email nuevo y uno con cuenta) -> 200 sin token ni datos de cuenta
POST {{host}}/salas/{{salaId}}/invitaciones
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "emails": ["{{newEmail}}", "{{otherEmail}}"]
}

> {%
client.test("invitar 200 uniforme", function() {
  client.assert(response.status === 200, "status " + response.status);
  const r = response.body.data.resultados;
  client.assert(r.length === 2, "resultados " + r.length);
  client.assert(r[0].estado === "INVITADO", "estado " + r[0].estado);
  client.assert(r[1].estado === "INVITADO", "estado " + r[1].estado);
  client.assert(
    Object.keys(r[0]).sort().join() === Object.keys(r[1]).sort().join(),
    "la forma del resultado delata si hay cuenta",
  );
  const raw = JSON.stringify(response.body);
  client.assert(raw.indexOf("token") === -1, "la respuesta no debe exponer token");
});
%}

### 12. Reinvitar al mismo email -> 200 REENVIADO
POST {{host}}/salas/{{salaId}}/invitaciones
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "emails": ["{{newEmail}}"]
}

> {%
client.test("reinvitar 200 REENVIADO", function() {
  client.assert(response.status === 200, "status " + response.status);
  client.assert(response.body.data.resultados[0].estado === "REENVIADO", "estado " + response.body.data.resultados[0].estado);
});
%}

### 13. Preview con token desconocido -> 410 INVITATION_INVALID
GET {{host}}/invitaciones/token-que-no-existe

> {%
client.test("preview token desconocido 410", function() {
  client.assert(response.status === 410, "status " + response.status);
  client.assert(response.body.error.code === "INVITATION_INVALID", "code " + response.body.error.code);
});
%}
