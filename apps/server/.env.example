# Database - Neon PostgreSQL
DATABASE_URL="postgresql://user:password@ep-xxxxx.region.aws.neon.tech/meetflow?schema=public"

# Server
NODE_ENV=development
PORT=4000
CORS_ORIGIN="http://localhost:3000"

# Auth - JWT
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_TTL_DAYS=7

# Auth - Bcrypt
BCRYPT_SALT_ROUNDS=12

# Frontend (usado para armar enlaces de invitación a la sala)
FRONTEND_URL="http://localhost:3000"

# GetStream Video/Audio (requeridas: el server no arranca sin ellas)
GETSTREAM_API_KEY="your-api-key"
GETSTREAM_API_SECRET="your-api-secret"
# Vigencia del token de GetStream que se entrega al cliente
STREAM_TOKEN_TTL_SECONDS=3600
# Vigencia del "guest JWT" del participante invitado. También define por
# cuánto tiempo un aprobado puede reingresar sin volver a pedir permiso.
PARTICIPANT_TOKEN_TTL_SECONDS=7200
# Verificación de la firma HMAC del webhook. Por defecto: on salvo en development.
WEBHOOK_VERIFY_SIGNATURE=true
