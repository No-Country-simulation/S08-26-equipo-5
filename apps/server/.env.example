# Database - Neon PostgreSQL
DATABASE_URL="postgresql://user:password@ep-xxxxx.region.aws.neon.tech/meetflow?schema=public"

# Server
NODE_ENV=development
PORT=4000
CORS_ORIGIN="http://localhost:3000"

# Auth - JWT
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_TTL_DAYS=7

# Auth - Bcrypt
BCRYPT_SALT_ROUNDS=12

# GetStream Video/Audio
GETSTREAM_API_KEY="your-api-key"
GETSTREAM_API_SECRET="your-api-secret"

# Webhooks - GetStream (S3-08)
# true|1 exige firma HMAC (default fuera de development). false|0 solo para desarrollo local.
WEBHOOK_SIGNATURE_REQUIRED=true
