%}

### 5. Crear sala -> 201
# @name sala
POST {{host}}/salas
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "nombre": "Waiting QA"
}

> {%
client.test("crear sala 201", function() {
  client.assert(response.status === 201, "status " + response.status);
  client.global.set("salaId", response.body.salaId);
  client.global.set("salaCodigo", response.body.codigo);
});
%}

### 6. Waiting room Socket.IO
GET {{root}}/api/v1/health

> {%
const { io } = require("socket.io-client");

// OJO: httpyac NO espera un client.test(async ...): lo marca OK antes de que
// corran sus asserts y sigue con el request siguiente. Por eso el flujo va con
// await a nivel superior (eso sí lo espera) y los asserts van en client.test
// síncronos al final.
function once(socket, event, ms = 5000) {
  return new Promise((resolve, reject) => {
    const t = setTimeout(() => reject(new Error("timeout esperando " + event)), ms);
    socket.once(event, (payload) => { clearTimeout(t); resolve(payload); });
  });
}

function connect(token) {
  const socket = io("http://localhost:4000/reuniones", {
    auth: token ? { token } : {},
    transports: ["websocket"],
    forceNew: true,
  });
  return new Promise((resolve, reject) => {
    socket.on("connect", () => resolve(socket));
    socket.on("connect_error", reject);
  });
}

const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

const hostToken = request.variables.get("accessToken");
const guestToken = request.variables.get("guestToken");
const salaId = request.variables.get("salaId");
const codigo = request.variables.get("salaCodigo");
const r = {};
const sockets = [];

try {
  const anon = await connect();
  sockets.push(anon);
  const noRoom = once(anon, "error");
  anon.emit("join:request", {
    salaCodigo: "NOEXISTE",
    nombre: "Ana",
    apellido: "Perez",
    email: "ana-noexiste@example.com",
  });
  r.roomErr = await noRoom;

  const unauth = once(anon, "error");
  anon.emit("host:subscribe", { salaId });
  r.unauthErr = await unauth;

  const guest = await connect(guestToken);
  sockets.push(guest);
  const forbidden = once(guest, "error");
  guest.emit("host:subscribe", { salaId });
  r.hostOnly = await forbidden;

  const host = await connect(hostToken);
  sockets.push(host);
  host.emit("host:subscribe", { salaId });
  await sleep(300);

  const pending = once(host, "join:pending");
  guest.emit("join:request", {
    salaCodigo: codigo,
    nombre: "Ana",
    apellido: "Perez",
    email: "ana-wait@example.com",
  });
  r.pendingPayload = await pending;

  const approved = once(guest, "join:approved");
  host.emit("participant:approve", { participanteId: r.pendingPayload.participanteId });
  r.approvedPayload = await approved;

  // Luis usa un socket anónimo (NO reutiliza `guest`, que es un usuario
  // logueado): un usuario logueado es un único participante por sala
  // (dedupe por usuarioId), así que un segundo join:request del mismo
  // socket `guest` reusaría la fila de Ana (ya APROBADO) y nunca emitiría
  // join:pending. Un invitado anónimo dedupe por email: es una identidad nueva.
  const luis = await connect();
  sockets.push(luis);
  const pending2 = once(host, "join:pending");
  luis.emit("join:request", {
    salaCodigo: codigo,
    nombre: "Luis",
    apellido: "Diaz",
    email: "luis-wait@example.com",
  });
  r.pending2Payload = await pending2;

  const rejected = once(luis, "join:rejected");
  host.emit("participant:reject", { participanteId: r.pending2Payload.participanteId });
  r.rejectedPayload = await rejected;

  const conflict = once(host, "error");
  host.emit("participant:reject", { participanteId: r.pending2Payload.participanteId });
  r.conflictErr = await conflict;
} catch (e) {
  r.error = e.message;
} finally {
  sockets.forEach((s) => s.close());
}

client.test("waiting room: flujo completo sin errores", function() {
  client.assert(!!salaId, "falta salaId de requests previos");
  client.assert(!r.error, "fallo el flujo: " + r.error);
});
client.test("join:request a sala inexistente -> ROOM_NOT_FOUND", function() {
  client.assert(r.roomErr?.code === "ROOM_NOT_FOUND", JSON.stringify(r.roomErr));
});
client.test("host:subscribe anonimo -> UNAUTHORIZED", function() {
  client.assert(r.unauthErr?.code === "UNAUTHORIZED", JSON.stringify(r.unauthErr));
});
client.test("host:subscribe de no-host -> HOST_ONLY", function() {
  client.assert(r.hostOnly?.code === "HOST_ONLY", JSON.stringify(r.hostOnly));
});
client.test("join:pending llega al host", function() {
  client.assert(!!r.pendingPayload?.participanteId, JSON.stringify(r.pendingPayload));
});
client.test("join:approved trae streamCallId", function() {
  client.assert(r.approvedPayload?.streamCallId != null, JSON.stringify(r.approvedPayload));
});
client.test("join:rejected trae streamCallId null", function() {
  client.assert(r.rejectedPayload?.streamCallId === null, JSON.stringify(r.rejectedPayload));
});
client.test("segundo reject -> PARTICIPANT_STATE_CONFLICT", function() {
  client.assert(r.conflictErr?.code === "PARTICIPANT_STATE_CONFLICT", JSON.stringify(r.conflictErr));
});
%}

### 7. POST /salas/:code/join (anónimo) -> 200 PENDIENTE + accessToken
# @name joinAnonimo
POST {{host}}/salas/{{salaCodigo}}/join
Content-Type: application/json

{
  "nombre": "Carla",
  "apellido": "Gomez",
  "email": "carla-wait-{{$timestamp}}@example.com"
}

> {%
client.test("join anonimo 200 PENDIENTE", function() {
  client.assert(response.status === 200, "status " + response.status);
  client.assert(response.body.estado === "PENDIENTE", JSON.stringify(response.body));
  client.assert(!!response.body.accessToken, "falta accessToken");
  client.global.set("carlaParticipanteId", response.body.participanteId);
  client.global.set("carlaToken", response.body.accessToken);
});
%}

