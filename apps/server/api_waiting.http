GET {{host}}/salas/{{salaId}}/mi-estado
Authorization: Bearer {{carlaToken}}

> {%
client.test("mi-estado PENDIENTE", function() {
  client.assert(response.status === 200, "status " + response.status);
  client.assert(response.body.estado === "PENDIENTE", JSON.stringify(response.body));
});
%}

### 9. POST /salas/:salaId/stream-token con guest PENDIENTE -> 403 JOIN_NOT_APPROVED
POST {{host}}/salas/{{salaId}}/stream-token
Authorization: Bearer {{carlaToken}}

> {%
client.test("stream-token 403 JOIN_NOT_APPROVED", function() {
  client.assert(response.status === 403, "status " + response.status);
  client.assert(response.body.error.code === "JOIN_NOT_APPROVED", JSON.stringify(response.body));
});
%}

### 10. Socket con guest token pendiente: auto-subscribe + approve + join:subscribe ajeno
GET {{root}}/api/v1/health

> {%
const { io } = require("socket.io-client");

// OJO: httpyac NO espera un client.test(async ...): lo marca OK antes de que
// corran sus asserts y sigue con el request siguiente. Por eso el flujo va con
// await a nivel superior (eso sí lo espera) y los asserts van en client.test
// síncronos al final.
function once(socket, event, ms = 5000) {
  return new Promise((resolve, reject) => {
    const t = setTimeout(() => reject(new Error("timeout esperando " + event)), ms);
    socket.once(event, (payload) => { clearTimeout(t); resolve(payload); });
  });
}

function connect(token) {
  const socket = io("http://localhost:4000/reuniones", {
    auth: token ? { token } : {},
    transports: ["websocket"],
    forceNew: true,
  });
  return new Promise((resolve, reject) => {
    socket.on("connect", () => resolve(socket));
    socket.on("connect_error", reject);
  });
}

const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

const hostToken = request.variables.get("accessToken");
const salaId = request.variables.get("salaId");
const carlaToken = request.variables.get("carlaToken");
const carlaParticipanteId = request.variables.get("carlaParticipanteId");
const r = {};
const sockets = [];

try {
  const host = await connect(hostToken);
  sockets.push(host);
  host.emit("host:subscribe", { salaId });
  await sleep(300);

  // Un socket ajeno (anónimo) intenta escuchar el room de Carla ANTES de la
  // aprobación: tiene que recibir FORBIDDEN y nunca ver su join:approved.
  const stranger = await connect();
  sockets.push(stranger);
  let strangerGotApproved = false;
  stranger.on("join:approved", () => { strangerGotApproved = true; });
  const forbidden = once(stranger, "error");
  stranger.emit("join:subscribe", { participanteId: carlaParticipanteId });
  r.forbiddenErr = await forbidden;

  // El socket con el guest JWT de Carla se autosuscribe a su room de
  // participante en el connect, sin emitir join:subscribe.
  const carla = await connect(carlaToken);
  sockets.push(carla);
  const approved = once(carla, "join:approved");
  host.emit("participant:approve", { participanteId: carlaParticipanteId });
  r.approvedPayload = await approved;

  await sleep(300);
  r.strangerGotApproved = strangerGotApproved;
} catch (e) {
  r.error = e.message;
} finally {
  sockets.forEach((s) => s.close());
}

client.test("guest JWT socket: flujo sin errores", function() {
  client.assert(!!carlaToken, "falta carlaToken del request anterior");
  client.assert(!r.error, "fallo el flujo: " + r.error);
});
client.test("join:subscribe ajeno -> FORBIDDEN", function() {
  client.assert(r.forbiddenErr?.code === "FORBIDDEN", JSON.stringify(r.forbiddenErr));
});
client.test("guest JWT autosuscripto recibe join:approved", function() {
  client.assert(r.approvedPayload?.streamCallId != null, JSON.stringify(r.approvedPayload));
});
client.test("el socket ajeno no recibe join:approved", function() {
  client.assert(r.strangerGotApproved === false, "el socket ajeno recibió join:approved");
});
%}

### 11. POST /salas/:salaId/stream-token con guest ya APROBADO -> 200 apiKey/token/callType/callId
POST {{host}}/salas/{{salaId}}/stream-token
Authorization: Bearer {{carlaToken}}

> {%
client.test("stream-token 200 aprobado", function() {
  client.assert(response.status === 200, "status " + response.status);
  client.assert(!!response.body.apiKey, "falta apiKey");
  client.assert(!!response.body.token, "falta token");
  client.assert(!!response.body.callType, "falta callType");
  client.assert(!!response.body.callId, "falta callId");
});
%}

### 12. POST /salas/:code/join logueado con body vacío -> 200, identidad autocompletada desde la cuenta
POST {{host}}/salas/{{salaCodigo}}/join
Content-Type: application/json
Authorization: Bearer {{guestToken}}

{}

> {%
client.test("join logueado (body vacio) 200, identidad de la cuenta", function() {
  client.assert(response.status === 200, "status " + response.status);
  client.assert(!!response.body.participanteId, JSON.stringify(response.body));
  // El invitado ya está logueado como "Invitado Waiting" (ver paso 3/4): el
  // body vacío no debería impedir el join ni pedir nombre/apellido/email.
});
%}
